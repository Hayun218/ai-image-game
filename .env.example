# ─────────────────────────────────────────────────────────────
# AI or Human? — 환경변수 목록 (키 이름만. 값은 절대 커밋하지 않는다)
# 로컬: 이 파일을 .env.local 로 복사해서 값을 채운다.
# Netlify: Site configuration → Environment variables 에 등록.
# GitHub Actions(build-pool): Settings → Secrets and variables → Actions 에 등록.
# ─────────────────────────────────────────────────────────────

# 게임 서버 (Netlify)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_PASSWORD=

# 비워 두면 로컬 mock 풀을 사용한다 (Redis 없이 플레이 가능). 값: mock | redis
POOL_BACKEND=

# 사진 수집 (build-pool 배치)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# 비전 LLM 점수/캡션/QC (build-pool 배치)
ANTHROPIC_API_KEY=

# AI 이미지 생성 (build-pool 배치)
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=

# 배치에서 Netlify Blobs 업로드용 (Netlify 런타임에서는 자동 주입되므로 불필요)
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
