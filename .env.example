# ─────────────────────────────────────────────────────────────
# AI or Human? — 환경변수 목록 (키 이름만. 값은 절대 커밋하지 않는다)
# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 gitignore 됨)
# ─────────────────────────────────────────────────────────────

# /admin Basic Auth 비밀번호
ADMIN_PASSWORD=

# 사진·쌍 데이터 폴더 (기본값: ./data). 이미지 파일과 pool.db 가 여기에 생긴다.
DATA_DIR=

# 사진 수집: Freepik API (AI 이미지 / 실제 사진 모두)
FREEPIK_API_KEY=

# 쌍 매칭·품질 검사용 비전 LLM
ANTHROPIC_API_KEY=

# 행사 중 자동 보충: 온라인이고 남은 쌍이 기준 미만이면 백그라운드로 새 쌍을 받아 온다.
# on | off (기본 on). 키가 없거나 오프라인이면 아무 일도 하지 않는다.
AUTO_PULL=
# 자동 보충을 시작하는 "아직 안 나간 쌍" 기준 수 (기본 300)
AUTO_PULL_LOW_WATERMARK=
